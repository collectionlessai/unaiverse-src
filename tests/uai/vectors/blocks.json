{
  "suite": "blocks",
  "cases": [
    {
      "id": "prose-only",
      "op": "parse",
      "input": {
        "text": "Ciao, come va?"
      },
      "expect": {
        "parts": [
          {
            "type": "text",
            "text": "Ciao, come va?"
          }
        ]
      }
    },
    {
      "id": "empty",
      "op": "parse",
      "input": {
        "text": ""
      },
      "expect": {
        "parts": []
      }
    },
    {
      "id": "prose-media-prose",
      "op": "parse",
      "input": {
        "text": "Guarda qui:\n\n```uai\n{\"v\":1,\"type\":\"media\",\"src\":\"https://cdn.example.org/a.jpg\",\"mime\":\"image/jpeg\",\"alt\":\"[foto] un gatto\"}\n```\n\nCarino, no?"
      },
      "expect": {
        "parts": [
          {
            "type": "text",
            "text": "Guarda qui:"
          },
          {
            "type": "media",
            "alt": "[foto] un gatto",
            "spec": {
              "v": 1,
              "type": "media",
              "src": "https://cdn.example.org/a.jpg",
              "mime": "image/jpeg",
              "alt": "[foto] un gatto"
            }
          },
          {
            "type": "text",
            "text": "Carino, no?"
          }
        ]
      }
    },
    {
      "id": "fence-with-spaces-and-four-ticks",
      "op": "parse",
      "input": {
        "text": "````  uai  \n{\"v\":1,\"type\":\"x-demo\",\"alt\":\"demo\"}\n````"
      },
      "expect": {
        "parts": [
          {
            "type": "x",
            "alt": "demo",
            "spec": {
              "type": "x-demo"
            }
          }
        ]
      }
    },
    {
      "id": "unterminated-fence-is-prose",
      "op": "parse",
      "input": {
        "text": "```uai\n{\"v\":1,\"type\":\"media\"}"
      },
      "expect": {
        "parts": [
          {
            "type": "text",
            "text": "```uai\n{\"v\":1,\"type\":\"media\"}"
          }
        ]
      }
    },
    {
      "id": "tilde-fence-is-prose",
      "op": "parse",
      "input": {
        "text": "~~~uai\n{\"v\":1,\"type\":\"x-a\",\"alt\":\"a\"}\n~~~"
      },
      "expect": {
        "parts": [
          {
            "type": "text",
            "text": "~~~uai\n{\"v\":1,\"type\":\"x-a\",\"alt\":\"a\"}\n~~~"
          }
        ]
      }
    },
    {
      "id": "other-code-fence-untouched",
      "op": "parse",
      "input": {
        "text": "```js\nconsole.log(1)\n```"
      },
      "expect": {
        "parts": [
          {
            "type": "text",
            "text": "```js\nconsole.log(1)\n```"
          }
        ]
      }
    },
    {
      "id": "json-invalid-degrades-raw",
      "op": "parse",
      "input": {
        "text": "```uai\n{not json\n```"
